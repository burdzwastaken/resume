\documentclass[$if(fontsize)$$fontsize$$else$11pt$endif$]{article}

% page geometry
\usepackage[margin=0.75in]{geometry}

% fonts (xelatex)
\usepackage{fontspec}
$if(mainfont)$\setmainfont{$mainfont$}$endif$
$if(sansfont)$\setsansfont{$sansfont$}$endif$
$if(monofont)$\setmonofont{$monofont$}$endif$

% typography
\usepackage{microtype}
\usepackage{parskip}
\setlength{\parindent}{0pt}

% colors
\usepackage[usenames,dvipsnames]{xcolor}
\definecolor{linkcolor}{HTML}{2B6CB0}
\definecolor{rulecolor}{HTML}{CBD5E0}
\definecolor{lightgray}{HTML}{718096}

% links
\usepackage[hidelinks]{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkcolor,
  urlcolor=linkcolor,
  pdftitle={$name$ - Resume},
  pdfauthor={$name$}
}

% lists
\usepackage{enumitem}
\setlist[itemize]{leftmargin=1.5em, itemsep=0.25em, parsep=0pt, topsep=0.25em}

% definition lists (pandoc uses these for : syntax)
\usepackage{longtable,booktabs}
\newenvironment{CSLReferences}[2]{}{}

% headers
\usepackage{titlesec}
\titleformat{\section}
  {\large\bfseries\sffamily}
  {}{0em}{}
  [\vspace{-0.5em}{\color{rulecolor}\rule{\textwidth}{0.5pt}}\vspace{-0.5em}]

\titleformat{\subsection}
  {\normalsize\bfseries\sffamily}
  {}{0em}{}

\titlespacing*{\section}{0pt}{1em}{0.5em}
\titlespacing*{\subsection}{0pt}{0.75em}{0.25em}

% no page numbers
\pagestyle{empty}

% pandoc tightlist
\providecommand{\tightlist}{\setlength{\itemsep}{0.25em}\setlength{\parskip}{0pt}}

\begin{document}

% header
\begin{center}
  {\LARGE\bfseries\sffamily $name$}
\end{center}

\vspace{0.25em}

\begin{minipage}[t]{0.48\textwidth}
\raggedright
\small
$for(left-column)$
$left-column$\\
$endfor$
\end{minipage}
\hfill
\begin{minipage}[t]{0.48\textwidth}
\raggedleft
\small
$for(right-column)$
$right-column$\\
$endfor$
\end{minipage}

\vspace{0.5em}
{\color{rulecolor}\rule{\textwidth}{0.5pt}}

$body$

\end{document}
